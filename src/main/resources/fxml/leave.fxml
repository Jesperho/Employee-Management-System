<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Text?>
<?import javafx.scene.shape.Circle?>

<?import javafx.collections.FXCollections?>
<?import java.lang.String?>
<BorderPane xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controller.LeaveController"
            styleClass="dashboard-root">

    <left>
        <VBox styleClass="sidebar" prefWidth="250" minWidth="220" maxWidth="280" spacing="0">
            <VBox styleClass="sidebar-header" alignment="CENTER" spacing="5">
                <padding><Insets top="20" bottom="20" left="15" right="15"/></padding>
                <Text text="EMS" styleClass="logo-text"/>
                <Text text="Employee Management" styleClass="logo-subtitle"/>

            </VBox>
            <VBox styleClass="user-profile" alignment="CENTER" spacing="8">
                <padding><Insets top="15" bottom="15" left="15" right="15"/></padding>
                <StackPane styleClass="avatar-container">
                    <Circle radius="35" styleClass="avatar-circle"/>
                    <Text fx:id="avatarInitials" text="AD" styleClass="avatar-text"/>
                </StackPane>
                <Text fx:id="userName" text="Admin" styleClass="user-name"/>
                <Text fx:id="userRole" text="Administrator" styleClass="user-role"/>
                <VBox alignment="CENTER">
                    <ComboBox fx:id="languageComboBox" promptText="English" styleClass="language-switcher-combo" >
                        <items >
                            <FXCollections fx:factory="observableArrayList">
                                <String fx:value="English" />
                                <String fx:value="Spanish"/>
                                <String fx:value="Persia"/>
                                <String fx:value="Arabic"/>
                            </FXCollections>
                        </items>
                    </ComboBox>
                </VBox>
            </VBox>
            <VBox styleClass="nav-menu" spacing="5">
                <padding><Insets top="10" bottom="10" left="10" right="10"/></padding>
                <Text text="MAIN MENU" styleClass="menu-section-label"/>
                <Button fx:id="btnDashboard" text="📊  Dashboard" styleClass="nav-button" onAction="#handleDashboard" maxWidth="Infinity" alignment="CENTER_LEFT"/>
                <Button fx:id="btnEmployees" text="👥  Employees" styleClass="nav-button" onAction="#handleEmployees" maxWidth="Infinity" alignment="CENTER_LEFT"/>
                <Button fx:id="btnDepartments" text="🏢  Departments" styleClass="nav-button" onAction="#handleDepartments" maxWidth="Infinity" alignment="CENTER_LEFT"/>
                <Button fx:id="btnLeave" text="📅  Leave Management" styleClass="nav-button, nav-button-active" onAction="#handleLeave" maxWidth="Infinity" alignment="CENTER_LEFT"/>
                <Button fx:id="btnSalary" text="💰  Salary" styleClass="nav-button" onAction="#handleSalary" maxWidth="Infinity" alignment="CENTER_LEFT"/>
                <Region VBox.vgrow="ALWAYS"/>
                <Button fx:id="btnLogout" text="🚪  Logout" styleClass="nav-button, logout-button" onAction="#handleLogout" maxWidth="Infinity" alignment="CENTER_LEFT"/>
            </VBox>
        </VBox>
    </left>

    <center>
        <VBox styleClass="main-content" minWidth="0">
            <HBox styleClass="header-bar" alignment="CENTER_LEFT" spacing="20">
                <padding><Insets top="15" bottom="15" left="25" right="25"/></padding>
                <VBox spacing="2"><Text fx:id="breadcrumbText" text="Dashboard / Leave Management" styleClass="page-breadcrumb"/></VBox>
                <Region HBox.hgrow="ALWAYS"/>
                <HBox styleClass="search-container" alignment="CENTER_LEFT" spacing="10">
                    <TextField fx:id="searchField" promptText="Search leave records..." styleClass="search-field" prefWidth="250" maxWidth="350" onAction="#handleSearch"/>
                    <Button text="🔍" styleClass="search-button" onAction="#handleSearch"/>
                </HBox>
            </HBox>
            <ScrollPane styleClass="content-scroll" fitToWidth="true" fitToHeight="false" VBox.vgrow="ALWAYS">
                <VBox styleClass="dashboard-content" spacing="20">
                    <padding><Insets top="25" bottom="25" left="25" right="25"/></padding>

                    <!-- Title -->
                    <Text fx:id="pageTitleText" text="📋 Leave Management" styleClass="page-title"/>

                    <!-- Banner -->
                    <VBox styleClass="leave-banner" spacing="8" alignment="CENTER_LEFT">
                        <padding><Insets top="30" bottom="30" left="30" right="30"/></padding>
                        <Text fx:id="bannerTitleText" text="Manage ALL Leave Applications" styleClass="banner-title"/>
                        <Text fx:id="bannerSubtitleText" text="A relaxed employee is a performing employee. Track, approve, and manage all leave requests efficiently." styleClass="banner-subtitle"/>
                    </VBox>

                    <!-- Quick Action Buttons -->
                    <HBox spacing="15">
                        <Button fx:id="btnAddLeave" text="📝 Add Leave" styleClass="leave-action-btn, leave-action-primary" onAction="#handleApplyLeave"/>
                        <Button fx:id="btnLeaveHistory" text="📊 Leave History" styleClass="leave-action-btn, leave-action-secondary" onAction="#handleLeaveHistory"/>
                    </HBox>

                    <!-- Stats Row -->
                    <HBox spacing="15" alignment="CENTER">
                        <VBox styleClass="stat-card, stat-card-blue" HBox.hgrow="ALWAYS" spacing="5" alignment="CENTER">
                            <padding><Insets top="15" bottom="15" left="15" right="15"/></padding>
                            <Text fx:id="totalLeaves" text="45" styleClass="stat-number-sm"/>
                            <Text fx:id="totalLeavesLabelText" text="Total Leaves" styleClass="stat-label"/>
                        </VBox>
                        <VBox styleClass="stat-card, stat-card-green" HBox.hgrow="ALWAYS" spacing="5" alignment="CENTER">
                            <padding><Insets top="15" bottom="15" left="15" right="15"/></padding>
                            <Text fx:id="activeLeaves" text="3" styleClass="stat-number-sm"/>
                            <Text fx:id="activeLeavesLabelText" text="Currently On Leave" styleClass="stat-label"/>
                        </VBox>
                        <VBox styleClass="stat-card, stat-card-orange" HBox.hgrow="ALWAYS" spacing="5" alignment="CENTER">
                            <padding><Insets top="15" bottom="15" left="15" right="15"/></padding>
                            <Text fx:id="sickLeaves" text="5" styleClass="stat-number-sm"/>
                            <Text fx:id="sickLeavesLabelText" text="Sick Leaves" styleClass="stat-label"/>
                        </VBox>
                        <VBox styleClass="stat-card, stat-card-purple" HBox.hgrow="ALWAYS" spacing="5" alignment="CENTER">
                            <padding><Insets top="15" bottom="15" left="15" right="15"/></padding>
                            <Text fx:id="avgDuration" text="12" styleClass="stat-number-sm"/>
                            <Text fx:id="avgDurationLabelText" text="Avg Duration (days)" styleClass="stat-label"/>
                        </VBox>
                    </HBox>

                    <!-- Leave History Table -->
                    <HBox alignment="CENTER_LEFT" spacing="15">
                        <Text fx:id="historyTitleText" text="Leave History" styleClass="card-title"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <ComboBox fx:id="filterDepartment" promptText="All Departments" styleClass="filter-combo" prefWidth="160"/>
                        <ComboBox fx:id="filterType" promptText="All Types" styleClass="filter-combo" prefWidth="140"/>
                        <Button fx:id="btnAddLeaveBottom" text="➕ Add Leave" styleClass="action-primary" onAction="#handleApplyLeave"/>
                    </HBox>

                    <VBox styleClass="content-card" spacing="0" VBox.vgrow="ALWAYS">
                        <TableView fx:id="leaveTable" styleClass="management-table"
                                   VBox.vgrow="ALWAYS" prefHeight="400" maxHeight="Infinity" maxWidth="Infinity">
                            <columns>
                                <TableColumn fx:id="colId" text="ID" prefWidth="50" minWidth="40"/>
                                <TableColumn fx:id="colEmployee" text="Employee" prefWidth="145" minWidth="100"/>
                                <TableColumn fx:id="colDuration" text="Duration (days)" prefWidth="110" minWidth="80"/>
                                <TableColumn fx:id="colStartDate" text="Start Date" prefWidth="105" minWidth="80"/>
                                <TableColumn fx:id="colEndDate" text="End Date" prefWidth="105" minWidth="80"/>
                                <TableColumn fx:id="colType" text="Type" prefWidth="95" minWidth="70"/>
                                <TableColumn fx:id="colReason" text="Reason" prefWidth="125" minWidth="90"/>
                                <TableColumn fx:id="colActions" text="Actions" prefWidth="140" minWidth="120"/>
                            </columns>
                        </TableView>
                    </VBox>

                    <HBox alignment="CENTER" spacing="10">
                        <Button text="◀ Previous" styleClass="pagination-button" onAction="#handlePreviousPage"/>
                        <Text fx:id="pageInfo" text="Page 1 of 1" styleClass="page-info"/>
                        <Button text="Next ▶" styleClass="pagination-button" onAction="#handleNextPage"/>
                    </HBox>
                </VBox>
            </ScrollPane>
        </VBox>
    </center>
</BorderPane>

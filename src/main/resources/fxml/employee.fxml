<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Text?>
<?import javafx.scene.shape.Circle?>

<BorderPane xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controller.EmployeeController"
            styleClass="dashboard-root">

    <!-- Left Sidebar -->
    <left>
        <VBox styleClass="sidebar" prefWidth="250" spacing="0">
            <VBox styleClass="sidebar-header" alignment="CENTER" spacing="5">
                <padding><Insets top="20" bottom="20" left="15" right="15"/></padding>
                <Text text="EMS" styleClass="logo-text"/>
                <Text text="Employee Management" styleClass="logo-subtitle"/>
            </VBox>

            <VBox styleClass="user-profile" alignment="CENTER" spacing="8">
                <padding><Insets top="15" bottom="15" left="15" right="15"/></padding>
                <StackPane styleClass="avatar-container">
                    <Circle radius="35" styleClass="avatar-circle"/>
                    <Text text="OA" styleClass="avatar-text"/>
                </StackPane>
                <Text text="Osama Admin" styleClass="user-name"/>
                <Text text="Administrator" styleClass="user-role"/>
            </VBox>

            <VBox styleClass="nav-menu" spacing="5">
                <padding><Insets top="10" bottom="10" left="10" right="10"/></padding>
                <Text text="MAIN MENU" styleClass="menu-section-label"/>
                <Button fx:id="btnDashboard" text="📊  Dashboard" styleClass="nav-button"
                        onAction="#handleDashboard" maxWidth="Infinity" alignment="CENTER_LEFT"/>
                <Button fx:id="btnEmployees" text="👥  Employees" styleClass="nav-button, nav-button-active"
                        onAction="#handleEmployees" maxWidth="Infinity" alignment="CENTER_LEFT"/>
                <Button fx:id="btnDepartments" text="🏢  Departments" styleClass="nav-button"
                        onAction="#handleDepartments" maxWidth="Infinity" alignment="CENTER_LEFT"/>
                <Button fx:id="btnLeave" text="📅  Leave Management" styleClass="nav-button"
                        onAction="#handleLeave" maxWidth="Infinity" alignment="CENTER_LEFT"/>
                <Button fx:id="btnSalary" text="💰  Salary" styleClass="nav-button"
                        onAction="#handleSalary" maxWidth="Infinity" alignment="CENTER_LEFT"/>
                <Region VBox.vgrow="ALWAYS"/>
                <Text text="SETTINGS" styleClass="menu-section-label"/>
                <Button text="⚙️  Settings" styleClass="nav-button" maxWidth="Infinity" alignment="CENTER_LEFT"/>
                <Button fx:id="btnLogout" text="🚪  Logout" styleClass="nav-button, logout-button"
                        onAction="#handleLogout" maxWidth="Infinity" alignment="CENTER_LEFT"/>
            </VBox>
        </VBox>
    </left>

    <!-- Main Content -->
    <center>
        <VBox styleClass="main-content">
            <!-- Header Bar -->
            <HBox styleClass="header-bar" alignment="CENTER_LEFT" spacing="20">
                <padding><Insets top="15" bottom="15" left="25" right="25"/></padding>
                <VBox spacing="2">
                    <Text text="Dashboard / Employee Management" styleClass="page-breadcrumb"/>
                </VBox>
                <Region HBox.hgrow="ALWAYS"/>
                <HBox styleClass="search-container" alignment="CENTER_LEFT" spacing="10">
                    <TextField fx:id="searchField" promptText="Search employees..."
                               styleClass="search-field" prefWidth="300" onAction="#handleSearch"/>
                    <Button text="🔍" styleClass="search-button" onAction="#handleSearch"/>
                </HBox>
                <Button text="🔔" styleClass="icon-button"/>
            </HBox>

            <!-- Content -->
            <ScrollPane styleClass="content-scroll" fitToWidth="true" VBox.vgrow="ALWAYS">
                <VBox styleClass="dashboard-content" spacing="20">
                    <padding><Insets top="25" bottom="25" left="25" right="25"/></padding>

                    <!-- Page Title + Actions -->
                    <VBox spacing="10">
                        <HBox alignment="CENTER_LEFT" spacing="15">
                            <Text text="Employee Management" styleClass="page-title"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Button text="➕ Add Employee" styleClass="action-primary" onAction="#handleAddEmployee"/>
                        </HBox>
                        <HBox spacing="10" alignment="CENTER_LEFT">
                            <ComboBox fx:id="filterDepartment" promptText="All Departments" styleClass="filter-combo" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                            <ComboBox fx:id="filterGender" promptText="All Genders" styleClass="filter-combo" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                            <ComboBox fx:id="filterContract" promptText="All Contracts" styleClass="filter-combo" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                        </HBox>
                    </VBox>

                    <!-- Stats Row -->
                    <HBox spacing="15" alignment="CENTER">
                        <VBox styleClass="stat-card, stat-card-blue" HBox.hgrow="ALWAYS" spacing="5" alignment="CENTER">
                            <padding><Insets top="15" bottom="15" left="15" right="15"/></padding>
                            <Text fx:id="totalCount" text="540" styleClass="stat-number-sm"/>
                            <Text text="Total Employees" styleClass="stat-label"/>
                        </VBox>
                        <VBox styleClass="stat-card, stat-card-green" HBox.hgrow="ALWAYS" spacing="5" alignment="CENTER">
                            <padding><Insets top="15" bottom="15" left="15" right="15"/></padding>
                            <Text fx:id="fullTimeCount" text="420" styleClass="stat-number-sm"/>
                            <Text text="Full Time" styleClass="stat-label"/>
                        </VBox>
                        <VBox styleClass="stat-card, stat-card-orange" HBox.hgrow="ALWAYS" spacing="5" alignment="CENTER">
                            <padding><Insets top="15" bottom="15" left="15" right="15"/></padding>
                            <Text fx:id="remoteCount" text="85" styleClass="stat-number-sm"/>
                            <Text text="Remote" styleClass="stat-label"/>
                        </VBox>
                        <VBox styleClass="stat-card, stat-card-purple" HBox.hgrow="ALWAYS" spacing="5" alignment="CENTER">
                            <padding><Insets top="15" bottom="15" left="15" right="15"/></padding>
                            <Text fx:id="internCount" text="35" styleClass="stat-number-sm"/>
                            <Text text="Interns" styleClass="stat-label"/>
                        </VBox>
                    </HBox>

                    <!-- Employee Table -->
                    <VBox styleClass="content-card" spacing="0">
                        <padding><Insets top="0" bottom="0" left="0" right="0"/></padding>

                        <TableView fx:id="employeeTable" styleClass="management-table" VBox.vgrow="ALWAYS" prefHeight="450">
                            <columns>
                                <TableColumn fx:id="colId" text="ID" prefWidth="60"/>
                                <TableColumn fx:id="colName" text="Name" prefWidth="160"/>
                                <TableColumn fx:id="colDepartment" text="Department" prefWidth="130"/>
                                <TableColumn fx:id="colJobTitle" text="Job Title" prefWidth="140"/>
                                <TableColumn fx:id="colStartDate" text="Start Date" prefWidth="110"/>
                                <TableColumn fx:id="colContract" text="Contract" prefWidth="100"/>
                                <TableColumn fx:id="colGender" text="Gender" prefWidth="80"/>
                                <TableColumn fx:id="colActions" text="Actions" prefWidth="160"/>
                            </columns>
                        </TableView>
                    </VBox>

                    <!-- Pagination -->
                    <HBox alignment="CENTER" spacing="10">
                        <Button text="◀ Previous" styleClass="pagination-button" onAction="#handlePreviousPage"/>
                        <Text fx:id="pageInfo" text="Page 1 of 1" styleClass="page-info"/>
                        <Button text="Next ▶" styleClass="pagination-button" onAction="#handleNextPage"/>
                    </HBox>

                </VBox>
            </ScrollPane>
        </VBox>
    </center>
</BorderPane>

<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Text?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.image.ImageView?>

<BorderPane xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controller.DashboardController"
            styleClass="dashboard-root">

    <!-- Left Sidebar -->
    <left>
        <VBox styleClass="sidebar" prefWidth="250" spacing="0">
            <!-- Logo/Brand Section -->
            <VBox styleClass="sidebar-header" alignment="CENTER" spacing="5">
                <padding>
                    <Insets top="20" bottom="20" left="15" right="15"/>
                </padding>
                <Text text="EMS" styleClass="logo-text"/>
                <Text text="Employee Management" styleClass="logo-subtitle"/>
            </VBox>

            <!-- User Profile Section -->
            <VBox styleClass="user-profile" alignment="CENTER" spacing="8">
                <padding>
                    <Insets top="15" bottom="15" left="15" right="15"/>
                </padding>
                <StackPane styleClass="avatar-container">
                    <Circle radius="35" styleClass="avatar-circle"/>
                    <Text fx:id="avatarInitials" text="OA" styleClass="avatar-text"/>
                </StackPane>
                <Text fx:id="userName" text="Osama Admin" styleClass="user-name"/>
                <Text fx:id="userRole" text="Administrator" styleClass="user-role"/>
            </VBox>

            <!-- Navigation Menu -->
            <VBox styleClass="nav-menu" spacing="5">
                <padding>
                    <Insets top="10" bottom="10" left="10" right="10"/>
                </padding>

                <Text text="MAIN MENU" styleClass="menu-section-label"/>

                <Button fx:id="btnDashboard" text="📊  Dashboard" styleClass="nav-button, nav-button-active"
                        onAction="#handleDashboard" maxWidth="Infinity" alignment="CENTER_LEFT"/>
                <Button fx:id="btnEmployees" text="👥  Employees" styleClass="nav-button"
                        onAction="#handleEmployees" maxWidth="Infinity" alignment="CENTER_LEFT"/>
                <Button fx:id="btnDepartments" text="🏢  Departments" styleClass="nav-button"
                        onAction="#handleDepartments" maxWidth="Infinity" alignment="CENTER_LEFT"/>
                <Button fx:id="btnLeave" text="📅  Leave Management" styleClass="nav-button"
                        onAction="#handleLeave" maxWidth="Infinity" alignment="CENTER_LEFT"/>
                <Button fx:id="btnSalary" text="💰  Salary" styleClass="nav-button"
                        onAction="#handleSalary" maxWidth="Infinity" alignment="CENTER_LEFT"/>

                <Region VBox.vgrow="ALWAYS"/>

                <Text text="SETTINGS" styleClass="menu-section-label"/>
                <Button text="⚙️  Settings" styleClass="nav-button" maxWidth="Infinity" alignment="CENTER_LEFT"/>
                <Button fx:id="btnLogout" text="🚪  Logout" styleClass="nav-button, logout-button"
                        onAction="#handleLogout" maxWidth="Infinity" alignment="CENTER_LEFT"/>
            </VBox>
        </VBox>
    </left>

    <!-- Main Content Area -->
    <center>
        <VBox styleClass="main-content">
            <!-- Top Header Bar -->
            <HBox styleClass="header-bar" alignment="CENTER_LEFT" spacing="20">
                <padding>
                    <Insets top="15" bottom="15" left="25" right="25"/>
                </padding>

                <VBox spacing="2">
                    <Text fx:id="welcomeText" text="Welcome back, Osama!" styleClass="welcome-title"/>
                    <Text fx:id="dateText" text="Monday, February 10, 2026" styleClass="date-text"/>
                </VBox>

                <Region HBox.hgrow="ALWAYS"/>

                <!-- Search Bar -->
                <HBox styleClass="search-container" alignment="CENTER_LEFT" spacing="10">
                    <TextField fx:id="searchField" promptText="Search employees, departments..."
                               styleClass="search-field" prefWidth="300"/>
                    <Button text="🔍" styleClass="search-button" onAction="#handleSearch"/>
                </HBox>

                <!-- Notifications -->
                <Button text="🔔" styleClass="icon-button"/>
            </HBox>

            <!-- Dashboard Content -->
            <ScrollPane styleClass="content-scroll" fitToWidth="true" VBox.vgrow="ALWAYS">
                <VBox styleClass="dashboard-content" spacing="25">
                    <padding>
                        <Insets top="25" bottom="25" left="25" right="25"/>
                    </padding>

                    <!-- Stats Cards Row -->
                    <HBox spacing="20" alignment="CENTER">
                        <!-- Total Employees Card -->
                        <VBox styleClass="stat-card, stat-card-blue" HBox.hgrow="ALWAYS" spacing="10" alignment="CENTER">
                            <padding>
                                <Insets top="20" bottom="20" left="20" right="20"/>
                            </padding>
                            <HBox alignment="CENTER" spacing="15">
                                <Text text="👥" styleClass="stat-icon"/>
                                <VBox spacing="2">
                                    <Text fx:id="totalEmployeesCount" text="540" styleClass="stat-number"/>
                                    <Text text="Total Employees" styleClass="stat-label"/>
                                </VBox>
                            </HBox>
                            <HBox alignment="CENTER" spacing="5">
                                <Text text="↑ 12%" styleClass="stat-change-positive"/>
                                <Text text="vs last month" styleClass="stat-change-label"/>
                            </HBox>
                        </VBox>

                        <!-- Active Employees Card -->
                        <VBox styleClass="stat-card, stat-card-green" HBox.hgrow="ALWAYS" spacing="10" alignment="CENTER">
                            <padding>
                                <Insets top="20" bottom="20" left="20" right="20"/>
                            </padding>
                            <HBox alignment="CENTER" spacing="15">
                                <Text text="✓" styleClass="stat-icon"/>
                                <VBox spacing="2">
                                    <Text fx:id="activeEmployeesCount" text="532" styleClass="stat-number"/>
                                    <Text text="Active Employees" styleClass="stat-label"/>
                                </VBox>
                            </HBox>
                            <HBox alignment="CENTER" spacing="5">
                                <Text text="98.5%" styleClass="stat-change-positive"/>
                                <Text text="attendance rate" styleClass="stat-change-label"/>
                            </HBox>
                        </VBox>

                        <!-- On Leave Card -->
                        <VBox styleClass="stat-card, stat-card-orange" HBox.hgrow="ALWAYS" spacing="10" alignment="CENTER">
                            <padding>
                                <Insets top="20" bottom="20" left="20" right="20"/>
                            </padding>
                            <HBox alignment="CENTER" spacing="15">
                                <Text text="📅" styleClass="stat-icon"/>
                                <VBox spacing="2">
                                    <Text fx:id="onLeaveCount" text="8" styleClass="stat-number"/>
                                    <Text text="On Leave" styleClass="stat-label"/>
                                </VBox>
                            </HBox>
                            <HBox alignment="CENTER" spacing="5">
                                <Text text="3 pending" styleClass="stat-change-neutral"/>
                                <Text text="requests" styleClass="stat-change-label"/>
                            </HBox>
                        </VBox>

                        <!-- Departments Card -->
                        <VBox styleClass="stat-card, stat-card-purple" HBox.hgrow="ALWAYS" spacing="10" alignment="CENTER">
                            <padding>
                                <Insets top="20" bottom="20" left="20" right="20"/>
                            </padding>
                            <HBox alignment="CENTER" spacing="15">
                                <Text text="🏢" styleClass="stat-icon"/>
                                <VBox spacing="2">
                                    <Text fx:id="departmentsCount" text="12" styleClass="stat-number"/>
                                    <Text text="Departments" styleClass="stat-label"/>
                                </VBox>
                            </HBox>
                            <HBox alignment="CENTER" spacing="5">
                                <Text text="All active" styleClass="stat-change-positive"/>
                                <Text text="status" styleClass="stat-change-label"/>
                            </HBox>
                        </VBox>
                    </HBox>

                    <!-- Second Row: Recent Activities & Quick Actions -->
                    <HBox spacing="20">
                        <!-- Recent Activities -->
                        <VBox styleClass="content-card" HBox.hgrow="ALWAYS" spacing="15">
                            <padding>
                                <Insets top="20" bottom="20" left="20" right="20"/>
                            </padding>
                            <HBox alignment="CENTER_LEFT">
                                <Text text="Recent Activities" styleClass="card-title"/>
                                <Region HBox.hgrow="ALWAYS"/>
                                <Button text="View All" styleClass="link-button"/>
                            </HBox>

                            <VBox fx:id="recentActivitiesContainer" styleClass="activities-list" spacing="12">
                                <!-- Activity items will be populated dynamically -->
                                <HBox styleClass="activity-item" spacing="12" alignment="CENTER_LEFT">
                                    <StackPane styleClass="activity-icon-container, activity-new">
                                        <Text text="+" styleClass="activity-icon"/>
                                    </StackPane>
                                    <VBox spacing="2" HBox.hgrow="ALWAYS">
                                        <Text text="New employee added" styleClass="activity-title"/>
                                        <Text text="John Doe joined IT Department" styleClass="activity-description"/>
                                    </VBox>
                                    <Text text="2 hours ago" styleClass="activity-time"/>
                                </HBox>

                                <HBox styleClass="activity-item" spacing="12" alignment="CENTER_LEFT">
                                    <StackPane styleClass="activity-icon-container, activity-leave">
                                        <Text text="📅" styleClass="activity-icon"/>
                                    </StackPane>
                                    <VBox spacing="2" HBox.hgrow="ALWAYS">
                                        <Text text="Leave request approved" styleClass="activity-title"/>
                                        <Text text="Jane Smith - Vacation (5 days)" styleClass="activity-description"/>
                                    </VBox>
                                    <Text text="5 hours ago" styleClass="activity-time"/>
                                </HBox>

                                <HBox styleClass="activity-item" spacing="12" alignment="CENTER_LEFT">
                                    <StackPane styleClass="activity-icon-container, activity-update">
                                        <Text text="✎" styleClass="activity-icon"/>
                                    </StackPane>
                                    <VBox spacing="2" HBox.hgrow="ALWAYS">
                                        <Text text="Salary updated" styleClass="activity-title"/>
                                        <Text text="Mike Johnson - HR Department" styleClass="activity-description"/>
                                    </VBox>
                                    <Text text="Yesterday" styleClass="activity-time"/>
                                </HBox>

                                <HBox styleClass="activity-item" spacing="12" alignment="CENTER_LEFT">
                                    <StackPane styleClass="activity-icon-container, activity-department">
                                        <Text text="🏢" styleClass="activity-icon"/>
                                    </StackPane>
                                    <VBox spacing="2" HBox.hgrow="ALWAYS">
                                        <Text text="Department restructured" styleClass="activity-title"/>
                                        <Text text="Marketing team expanded" styleClass="activity-description"/>
                                    </VBox>
                                    <Text text="2 days ago" styleClass="activity-time"/>
                                </HBox>
                            </VBox>
                        </VBox>

                        <!-- Quick Actions Panel -->
                        <VBox styleClass="content-card" prefWidth="320" spacing="15">
                            <padding>
                                <Insets top="20" bottom="20" left="20" right="20"/>
                            </padding>
                            <Text text="Quick Actions" styleClass="card-title"/>

                            <VBox spacing="10">
                                <Button text="➕  Add New Employee" styleClass="action-button, action-primary"
                                        maxWidth="Infinity" onAction="#handleAddEmployee"/>
                                <Button text="📋  Create Department" styleClass="action-button"
                                        maxWidth="Infinity" onAction="#handleCreateDepartment"/>
                                <Button text="📝  Process Leave Request" styleClass="action-button"
                                        maxWidth="Infinity" onAction="#handleProcessLeave"/>
                                <Button text="💵  Run Payroll" styleClass="action-button"
                                        maxWidth="Infinity" onAction="#handleRunPayroll"/>
                                <Button text="📊  Generate Report" styleClass="action-button"
                                        maxWidth="Infinity" onAction="#handleGenerateReport"/>
                            </VBox>
                        </VBox>
                    </HBox>

                    <!-- Third Row: Department Overview & Salary Summary -->
                    <HBox spacing="20">
                        <!-- Department Overview -->
                        <VBox styleClass="content-card" HBox.hgrow="ALWAYS" spacing="15">
                            <padding>
                                <Insets top="20" bottom="20" left="20" right="20"/>
                            </padding>
                            <HBox alignment="CENTER_LEFT">
                                <Text text="Department Overview" styleClass="card-title"/>
                                <Region HBox.hgrow="ALWAYS"/>
                                <Button text="Manage" styleClass="link-button" onAction="#handleDepartments"/>
                            </HBox>

                            <TableView fx:id="departmentTable" styleClass="department-table" prefHeight="200">
                                <columns>
                                    <TableColumn fx:id="deptNameColumn" text="Department" prefWidth="150"/>
                                    <TableColumn fx:id="deptHeadColumn" text="Head" prefWidth="120"/>
                                    <TableColumn fx:id="deptEmployeesColumn" text="Employees" prefWidth="80"/>
                                    <TableColumn fx:id="deptStatusColumn" text="Status" prefWidth="100"/>
                                </columns>
                            </TableView>
                        </VBox>

                        <!-- Salary Summary -->
                        <VBox styleClass="content-card" prefWidth="350" spacing="15">
                            <padding>
                                <Insets top="20" bottom="20" left="20" right="20"/>
                            </padding>
                            <Text text="Salary Summary" styleClass="card-title"/>

                            <VBox spacing="15">
                                <VBox styleClass="salary-item" spacing="5">
                                    <HBox alignment="CENTER_LEFT">
                                        <Text text="Total Monthly Payroll" styleClass="salary-label"/>
                                        <Region HBox.hgrow="ALWAYS"/>
                                        <Text fx:id="totalPayroll" text="€285,000" styleClass="salary-value"/>
                                    </HBox>
                                    <ProgressBar progress="0.85" styleClass="salary-progress" maxWidth="Infinity"/>
                                </VBox>

                                <VBox styleClass="salary-item" spacing="5">
                                    <HBox alignment="CENTER_LEFT">
                                        <Text text="Average Salary" styleClass="salary-label"/>
                                        <Region HBox.hgrow="ALWAYS"/>
                                        <Text fx:id="avgSalary" text="€4,200" styleClass="salary-value"/>
                                    </HBox>
                                </VBox>

                                <VBox styleClass="salary-item" spacing="5">
                                    <HBox alignment="CENTER_LEFT">
                                        <Text text="Pending Payments" styleClass="salary-label"/>
                                        <Region HBox.hgrow="ALWAYS"/>
                                        <Text fx:id="pendingPayments" text="€12,500" styleClass="salary-value-pending"/>
                                    </HBox>
                                </VBox>

                                <Button text="View Full Report" styleClass="secondary-button" maxWidth="Infinity"
                                        onAction="#handleSalary"/>
                            </VBox>
                        </VBox>
                    </HBox>

                </VBox>
            </ScrollPane>
        </VBox>
    </center>
</BorderPane>
